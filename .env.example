# ==========================================
# INFERENCE BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=8080

# SQLite Database Location
DB_PATH=./inference.db

# JWT Secret for Signing Authentication Tokens
# Generate a new random secret with: openssl rand -hex 32
JWT_SECRET=your_generated_random_secret_here

# Modal Authentication (Required on your server)
# Found inside ~/.modal.toml or generated via: modal token new
MODAL_TOKEN_ID=ak-xxxxxxxxxxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxxxxxx
